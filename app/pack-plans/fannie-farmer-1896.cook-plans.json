            }
          },
          {
            "id": "cook-custard",
            "kind": "cook",
            "text": "Pour the mixture into the top of the double boiler and set it over — not in — water held at a bare simmer. Cook, stirring constantly and scraping the bottom, until the mixture thickens and a coating is formed on the spoon.",
            "label": "cook custard",
            "ingredientIdx": [
              0,
              1,
              2,
              3
