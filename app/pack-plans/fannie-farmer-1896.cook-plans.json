            "branch": "Cook",
            "minutes": {
              "est": 10,
              "handsOff": false
            },
            "cue": "until the mixture thickens and a coating is formed on the spoon"
          },
          {
            "id": "test-custard",
            "kind": "cook",
            "text": "Lift the spoon clear and look at its back. The custard should leave an even, opaque film; draw a finger through that film and the line should hold clean instead of running back together. If it is still thin and translucent, cook on and test again. If instead it has gone grainy — cooked too long — take it off the heat at once and beat it hard with a rotary (Dover) egg-beater: it may be restored to a smooth consistency, but the custard will not be as thick.",
            "label": "test custard doneness",
            "ingredientIdx": [
              0,
              1,
              2,
              3
            ],
            "sourceStep": 5,
            "implied": false,
            "needs": [
              "cook-custard"
            ],
            "branch": "Cook",
            "minutes": {
              "est": 2,
              "handsOff": false
            },
            "cue": "the line should hold clean instead of running back together"
          },
          {
            "id": "strain-custard",
            "kind": "cook",
            "text": "Strain the custard immediately through a fine sieve into a cold bowl. The sieve catches any threads of set egg, and getting it out of the hot pan stops the cooking.",
            "label": "strain custard",
            "ingredientIdx": [
              0,
              1,
              2,
              3
            ],
            "sourceStep": 6,
            "implied": false,
            "needs": [
              "test-custard"
            ],
            "branch": "Cook",
            "minutes": {
              "est": 2,
              "handsOff": false
            }
          },
          {
            "id": "chill-custard",
            "kind": "cook",
            "text": "Cover the custard and chill it until it is cold through. The old direction is a perforated tin — a cover that keeps dust off while letting the steam out — and that is what prevents a scum from forming on the surface.",
            "label": "chill custard",
            "ingredientIdx": [
              0,
              1,
              2,
              3
            ],
            "sourceStep": 7,
            "implied": false,
            "needs": [
              "strain-custard"
