          {
            "id": "mix-yolks-sugar-salt",
            "kind": "mise",
            "text": "Add the sugar and the salt to the beaten yolks and stir until the sugar is dissolved and the mixture is even.",
            "label": "mix yolks sugar salt",
            "ingredientIdx": [
